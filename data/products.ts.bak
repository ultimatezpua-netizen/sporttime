export const SERIES_LIST: Series[] = ['Fenix', 'Forerunner', 'Instinct', 'Epix', 'Venu', 'MARQ', 'Tactix'];

export const PURPOSES = ['Спорт', 'Туризм', 'Бег', 'Велоспорт', 'Плавання', 'Дайвінг', 'Тактика', 'Lifestyle', 'Фітнес', 'Здоровʼя'];

export const formatPrice = (price: number): string => {
  return price.toLocaleString('uk-UA') + ' ₴';
};

export const getProductById = (id: string): Product | undefined => {
  return PRODUCTS.find(p => p.id === id);
};

export const getProductsByIds = (ids: string[]): Product[] => {
  return PRODUCTS.filter(p => ids.includes(p.id));
};

