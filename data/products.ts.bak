export type Series = 'Fenix' | 'Forerunner' | 'Instinct' | 'Epix' | 'Venu' | 'MARQ' | 'Descent' | 'Tactix';
export type DisplayType = 'AMOLED' | 'MIP' | 'OLED';
export type ImageKey = 'fenix' | 'forerunner' | 'instinct' | 'venu' | 'epix';

export interface ProductSpec {
  key: string;
  label: string;
  value: string;
}

export interface Product {
  id: string;
  name: string;
  series: Series;
  price: number;
  oldPrice?: number;
  rating: number;
  reviewCount: number;
  colors: string[];
  colorHexes: string[];
  sizes: string[];
  display: DisplayType;
  solar: boolean;
  material: string;
  purpose: string[];
  waterResistance: number;
  batteryLife: string;
  gps: boolean;
  heartRate: boolean;
  pulseOx: boolean;
  music: boolean;
  inStock: boolean;
  isNew?: boolean;
  discount?: number;
  description: string;
  imageKey: ImageKey;
  specs: ProductSpec[];
}

